# ============================================
# PrunerrXT - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# Do NOT commit .env to version control!

# ============================================
# Application Settings
# ============================================

# Environment: development, production, test
NODE_ENV=production

# Server port
PORT=3000

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# Data directory for SQLite database
DATA_DIR=/app/data

# Database file path (within DATA_DIR)
DB_PATH=/app/data/prunerr.db

# ============================================
# Media Server (Required — pick one)
# ============================================

# Which media server PrunerrXT reads your library from.
# Options: plex, jellyfin, emby
# Defaults to plex, so existing installs need no change.
MEDIA_SERVER_TYPE=plex

# ============================================
# Plex Configuration (when MEDIA_SERVER_TYPE=plex)
# ============================================

# URL to your Plex Media Server
# Examples: http://192.168.1.100:32400, http://plex:32400
PLEX_URL=http://localhost:32400

# Plex authentication token
# How to find: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your_plex_token_here

# ============================================
# Sonarr Configuration (Optional)
# ============================================

# URL to your Sonarr instance
# Examples: http://192.168.1.100:8989, http://sonarr:8989
# Leave empty to disable Sonarr integration
SONARR_URL=http://localhost:8989

# Sonarr API key
# Found in Sonarr: Settings > General > Security > API Key
SONARR_API_KEY=your_sonarr_api_key_here

# ============================================
# Radarr Configuration (Optional)
# ============================================

# URL to your Radarr instance
# Examples: http://192.168.1.100:7878, http://radarr:7878
# Leave empty to disable Radarr integration
RADARR_URL=http://localhost:7878

# Radarr API key
# Found in Radarr: Settings > General > Security > API Key
RADARR_API_KEY=your_radarr_api_key_here

# ============================================
# Jellyfin / Emby Configuration
# (when MEDIA_SERVER_TYPE=jellyfin or emby)
# ============================================

# URL to your Jellyfin or Emby server
# Examples: http://192.168.1.100:8096, http://jellyfin:8096
JELLYFIN_URL=http://localhost:8096

# API key. Create one in Dashboard > Advanced > API Keys
JELLYFIN_API_KEY=

# Optional but recommended for Jellyfin: install the "Playback Reporting"
# plugin. Jellyfin core only records the most recent play per item, so without
# the plugin repeat views collapse into one event and play counts read low.
# PrunerrXT detects and uses the plugin automatically when present.

# ============================================
# Tautulli Configuration (Optional)
# ============================================

# URL to your Tautulli instance
# Examples: http://192.168.1.100:8181, http://tautulli:8181
# Leave empty to disable Tautulli integration
TAUTULLI_URL=http://localhost:8181

# Tautulli API key
# Found in Tautulli: Settings > Web Interface > API Key
TAUTULLI_API_KEY=your_tautulli_api_key_here

# ============================================
# Email Notifications (Optional)
# ============================================

# SMTP server hostname
# Examples: smtp.gmail.com, smtp.sendgrid.net
# Leave empty to disable email notifications
SMTP_HOST=

# SMTP server port
# Common ports: 587 (TLS), 465 (SSL), 25 (unencrypted)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=

# SMTP authentication password
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_PASS=

# Email address to send notifications from
SMTP_FROM=prunerr@example.com

# Email address to receive notifications
NOTIFICATION_EMAIL=admin@example.com

# ============================================
# Login & access (Optional)
# ============================================
# Off by default: anyone who can reach PrunerrXT can use it, as before, and the
# MCP connector stays disabled. Full guide: docs/authentication.md
AUTH_ENABLED=false

# Single sign-on through any OpenID Connect provider (built for Authentik).
# Issuer for Authentik: https://auth.example.com/application/o/<slug>/
# Redirect URI to register: <your PrunerrXT URL>/api/auth/oidc/callback
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Groups -> roles. Comma-separated group names from the provider's groups claim.
#   admin    everything, incl. Settings and the MCP connector
#   operator queue, protect, rules, scans - no Settings
#   viewer   read-only
# OIDC_ADMIN_GROUPS=prunerr-admins
# OIDC_OPERATOR_GROUPS=media-ops
# OIDC_VIEWER_GROUPS=family
# Role for users in none of those groups: none (refused), viewer, operator, admin
# OIDC_DEFAULT_ROLE=none
# OIDC_GROUPS_CLAIM=groups
# OIDC_SCOPES=openid profile email
# OIDC_PROVIDER_NAME=Authentik
# OIDC_AUTO_LOGIN=false

# A local account, as a fallback or instead of SSO.
# Hash a password with: node scripts/hash-password.mjs
# AUTH_LOCAL_ENABLED=false
# AUTH_LOCAL_USERNAME=admin
# AUTH_LOCAL_PASSWORD=
# AUTH_LOCAL_PASSWORD_HASH=
# AUTH_LOCAL_ROLE=admin

# Sessions and cookies
# AUTH_SESSION_TTL_HOURS=168
# AUTH_SESSION_SECRET=
# AUTH_COOKIE_SECURE=auto
# Public URL, used for the OIDC redirect URI and the MCP endpoint shown in Settings
# APP_URL=https://prunerr.example.com

# ============================================
# AI assistant connector (MCP)
# ============================================
# Serves the Model Context Protocol at /mcp for Claude, Cursor and friends,
# authenticated with the API key. Requires AUTH_ENABLED=true. Set to false
# for a hard off switch. Guide: docs/mcp.md
MCP_ENABLED=true

# ============================================
# Advanced Settings
# ============================================

# Deletions run in the background: Delete Now / Delete All queue jobs and the
# app stays usable. Jobs run one at a time per service (Sonarr and Radarr in
# parallel); raise this if your instances cope with more at once.
# DELETION_JOB_CONCURRENCY=1

# Deleting a file in Sonarr/Radarr happens inside one HTTP request, and a big
# file on a network share can take them minutes. PrunerrXT waits this long for a
# delete call (default 120000 ms = 2 min; floor 5000), then switches the job
# to "verifying": it checks every ARR_DELETE_VERIFY_INTERVAL_SECONDS whether
# the file is gone, for up to ARR_DELETE_VERIFY_MINUTES, and counts the
# deletion as done the moment it is. Only the end of that window is a failure.
# ARR_DELETE_TIMEOUT_MS=120000
# ARR_DELETE_VERIFY_MINUTES=30
# ARR_DELETE_VERIFY_INTERVAL_SECONDS=15

# Cron schedule for automatic scans (default: daily at 3 AM)
# Format: standard cron expression
# SCAN_CRON=0 3 * * *

# Number of days without watch to consider media stale
# STALE_DAYS=90

# Dry run mode - log actions without executing them
# DRY_RUN=false

# Enable debug mode for verbose API logging
# DEBUG=false
